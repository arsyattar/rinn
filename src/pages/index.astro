---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import HeroSection from '../components/HeroSection';
import ScrollRevealSection from '../components/ScrollRevealSection';
import AboutSection from '../components/AboutSection';
import CommissionPriceList from '../components/CommissionPriceList';
import TestimonialCarousel from '../components/TestimonialCarousel';
import FAQAccordion from '../components/FAQAccordion';
import Footer from '../components/Footer';
---

<Layout>
	<Navbar client:load />

	<main class="page-content">
		{/* Hero Section */}
		<HeroSection client:load />

		{/* 1. About / Character Profile Section */}
		<ScrollRevealSection
			client:visible
			id="about"
			sectionKey="about"
		>
			<AboutSection client:visible />
		</ScrollRevealSection>

		{/* 2. Pricing / Commission Packages Section with Embedded Artwork Swiper */}
		<ScrollRevealSection
			client:visible
			id="contact"
			sectionKey="pricing"
		>
			<CommissionPriceList client:visible />
		</ScrollRevealSection>

		{/* 3. Client Testimonials Section */}
		<ScrollRevealSection
			client:visible
			id="testimonials"
			sectionKey="testimonials"
		>
			<TestimonialCarousel client:visible />
		</ScrollRevealSection>

		{/* 4. FAQ Section */}
		<ScrollRevealSection
			client:visible
			id="faq"
			sectionKey="faq"
		>
			<FAQAccordion client:visible />
		</ScrollRevealSection>
	</main>

	<Footer client:visible />
</Layout>

<style>
	.page-content {
		width: 100%;
		max-width: 100%;
		overflow-x: clip;
		box-sizing: border-box;
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import HeroSection from '../components/HeroSection';
import ScrollRevealSection from '../components/ScrollRevealSection';
import CommissionPriceList from '../components/CommissionPriceList';
import TestimonialCarousel from '../components/TestimonialCarousel';
import FAQAccordion from '../components/FAQAccordion';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Navbar client:load />

	<main class="page-content">
		{/* Hero Section */}
		<HeroSection client:load />

		{/* 1. About / Character Profile Section */}
		<ScrollRevealSection
			client:visible
			id="about"
			badge="Character Dossier"
			title="About Me"
			subtitle="Official profile, character specifications, and origin lore of Amai Vaelithys."
		>
			<div class="about-card card-royal genshin-oc-card">
				<div class="genshin-decor-bg"></div>
				<div class="genshin-oc-grid">
					{/* Left: Character Portrait (Frameless & Clean) */}
					<div class="genshin-card-col">
						<div class="genshin-card-stack">
							<div class="genshin-portrait-wrap">
								<img
									src="/photo/amai_hd.png"
									alt="Amai Vaelithys — Genshin OC"
									class="genshin-oc-portrait"
									loading="eager"
								/>
							</div>
						</div>
						<div class="genshin-rarity-stars">
							<span class="star-icon">⭐</span>
							<span class="star-icon">⭐</span>
							<span class="star-icon">⭐</span>
							<span class="star-icon">⭐</span>
							<span class="star-icon">⭐</span>
						</div>
					</div>

					{/* Right: Character Info Details */}
					<div class="genshin-info-col">
						<div class="oc-header-group">
							<h3 class="oc-title-name">Amai Vaelithys</h3>
							<p class="oc-subtitle-title">Mondstadt Alchemist & Wandering Celestial Scholar</p>
						</div>

						<div class="oc-specs-table">
							<div class="oc-spec-row">
								<span class="oc-spec-key">Name</span>
								<span class="oc-spec-colon">:</span>
								<span class="oc-spec-val">
									<strong class="oc-main-name">Amai Vaelithys</strong>
									<span class="oc-alias">Nereida Astra</span>
								</span>
							</div>
							<div class="oc-spec-row">
								<span class="oc-spec-key">Age</span>
								<span class="oc-spec-colon">:</span>
								<span class="oc-spec-val">Physically 24 (2000+)</span>
							</div>
							<div class="oc-spec-row">
								<span class="oc-spec-key">Birthday</span>
								<span class="oc-spec-colon">:</span>
								<span class="oc-spec-val">29th September</span>
							</div>
							<div class="oc-spec-row">
								<span class="oc-spec-key">Height</span>
								<span class="oc-spec-colon">:</span>
								<span class="oc-spec-val">165cm</span>
							</div>
							<div class="oc-spec-row">
								<span class="oc-spec-key">Affiliation</span>
								<span class="oc-spec-colon">:</span>
								<span class="oc-spec-val highlight-affiliation">Knight of Favonious</span>
							</div>
						</div>

						<div class="oc-lore-box">
							<p class="oc-lore-text">
								A foreigner who decided to settle in Mondstadt and join the Knight of Favonious solely to study alchemy.
							</p>
						</div>

						<div class="oc-extra-badges">
							<span class="oc-pill">Mondstadt Resident</span>
							<span class="oc-pill">Alchemical Scholar</span>
							<span class="oc-pill">Ancient Celestial Lineage</span>
						</div>
					</div>
				</div>
			</div>
		</ScrollRevealSection>

		{/* 2. Pricing / Commission Packages Section with Embedded Artwork Swiper */}
		<ScrollRevealSection
			client:visible
			id="contact"
			badge="Commission Price List"
			title="Let’s Create Something Celestial"
			subtitle="Swipe through sample artwork and select your preferred commission package below to order directly via WhatsApp."
		>
			<CommissionPriceList client:visible />
		</ScrollRevealSection>

		{/* 3. Client Testimonials Section */}
		<ScrollRevealSection
			client:visible
			id="testimonials"
			badge="Client Feedback"
			title="Kind Words from Patrons"
			subtitle="Read what previous commissioners have shared about their custom artwork and experience."
		>
			<TestimonialCarousel client:visible />
		</ScrollRevealSection>

		{/* 4. FAQ Section */}
		<ScrollRevealSection
			client:visible
			id="faq"
			badge="Common Questions"
			title="Frequently Asked Inquiries"
			subtitle="Everything you need to know about the illustration workflow, turnaround times, and file delivery."
		>
			<FAQAccordion client:visible />
		</ScrollRevealSection>
	</main>

	<Footer />
</Layout>

<style>
	.page-content {
		width: 100%;
		max-width: 100%;
		overflow-x: clip;
		box-sizing: border-box;
	}

	/* ============================================
	   GENSHIN OC INTRODUCTION CARD
	============================================ */
	.genshin-oc-card {
		padding: 1.5rem 1.25rem;
		max-width: 980px;
		margin: 0 auto;
		width: 100%;
		box-sizing: border-box;
		position: relative;
		background: linear-gradient(135deg, #FFFFFF 0%, #F5F9FB 60%, #EBF4F7 100%);
		border: 1.5px solid var(--color-border-gold);
		box-shadow: 0 16px 40px rgba(30, 42, 69, 0.08), 0 4px 12px rgba(201, 166, 107, 0.12);
	}

	@media (min-width: 768px) {
		.genshin-oc-card {
			padding: 2.75rem 2.5rem;
		}
	}

	.genshin-oc-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		align-items: center;
		width: 100%;
	}

	@media (min-width: 820px) {
		.genshin-oc-grid {
			grid-template-columns: 280px minmax(0, 1fr);
			gap: 3.25rem;
		}
	}

	/* Left Card Column */
	.genshin-card-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}

	.genshin-card-stack {
		position: relative;
		width: 100%;
		max-width: 230px;
		margin: 0 auto 1rem auto;
	}

	@media (min-width: 820px) {
		.genshin-card-stack {
			max-width: 260px;
		}
	}

	/* Frameless Character Portrait */
	.genshin-portrait-wrap {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 1.25rem;
		overflow: hidden;
		background: transparent;
	}

	.genshin-oc-portrait {
		width: 100%;
		height: auto;
		max-height: 320px;
		object-fit: contain;
		display: block;
		filter: drop-shadow(0 8px 24px rgba(30, 42, 69, 0.12));
		transition: transform 0.3s ease;
	}

	.genshin-oc-portrait:hover {
		transform: scale(1.02);
	}

	/* 5 Stars Rating */
	.genshin-rarity-stars,
	.genshin-stars-row {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.25rem;
		margin-top: 0.75rem;
		font-size: 1.15rem;
	}

	.star-icon,
	.stars-gold {
		display: inline-flex;
		line-height: 1;
	}

	/* Right Info Column */
	.genshin-info-col {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
	}

	.oc-specs-table,
	.oc-specs-list {
		display: grid;
		grid-template-columns: auto auto 1fr;
		gap: 0.65rem 0.5rem;
		align-items: baseline;
		width: 100%;
	}

	@media (min-width: 640px) {
		.oc-specs-table,
		.oc-specs-list {
			gap: 0.8rem 0.75rem;
		}
	}

	.oc-spec-row {
		display: contents;
	}

	.oc-spec-key,
	.oc-spec-label {
		font-family: var(--font-serif);
		font-weight: 700;
		color: #1A365D;
		letter-spacing: 0.02em;
		white-space: nowrap;
		font-size: 0.95rem;
	}

	.oc-spec-colon {
		font-family: var(--font-serif);
		font-weight: 700;
		color: #1A365D;
		font-size: 0.95rem;
		padding: 0 0.1rem;
		text-align: center;
	}

	@media (min-width: 768px) {
		.oc-spec-key,
		.oc-spec-label,
		.oc-spec-colon {
			font-size: 1.15rem;
		}
	}

	.oc-spec-val,
	.oc-spec-value {
		font-weight: 600;
		color: #2C4260;
		font-size: 0.95rem;
		line-height: 1.4;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem;
	}

	@media (min-width: 768px) {
		.oc-spec-val,
		.oc-spec-value {
			font-size: 1.15rem;
		}
	}

	.oc-main-name {
		color: #1A365D;
		font-weight: 800;
	}

	.oc-alias {
		font-size: 0.82rem;
		color: #7B8BA2;
		font-weight: 500;
		font-style: italic;
	}

	.highlight-affiliation {
		color: #1A365D;
		font-weight: 700;
	}

	/* Story Lore Box */
	.oc-lore-box {
		background: rgba(255, 255, 255, 0.85);
		border-left: 3.5px solid var(--color-primary);
		border-radius: 0 0.85rem 0.85rem 0;
		padding: 1.1rem 1.25rem;
		box-shadow: 0 4px 14px rgba(30, 42, 69, 0.05);
	}

	.oc-lore-text {
		font-size: 0.96rem;
		color: #2D415E;
		line-height: 1.7;
		font-style: italic;
		margin: 0;
	}

	@media (min-width: 768px) {
		.oc-lore-text {
			font-size: 1.05rem;
		}
	}

	.oc-extra-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.35rem;
		justify-content: center;
		width: 100%;
	}

	.oc-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.75rem;
		background: #EFF6F8;
		border: 1px solid rgba(90, 147, 160, 0.3);
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 600;
		color: #3B6B78;
		letter-spacing: 0.02em;
	}

	/* Contact Box */
	.contact-box {
		max-width: 600px;
		margin: 0 auto;
		padding: 1.5rem 1.25rem;
		text-align: center;
		width: 100%;
		box-sizing: border-box;
	}

	@media (min-width: 640px) {
		.contact-box {
			padding: 2.25rem 2rem;
		}
	}

	.contact-single-card {
		display: flex;
		justify-content: center;
		margin-bottom: 1.75rem;
		width: 100%;
	}

	.contact-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		background: var(--color-surface-soft);
		border: 1px solid var(--color-border-subtle);
		padding: 1.1rem 1.5rem;
		border-radius: 0.95rem;
		width: 100%;
		max-width: 360px;
		box-shadow: var(--shadow-sm);
	}

	.contact-label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-gold);
		font-weight: 700;
	}

	.contact-link {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-secondary);
		word-break: break-all;
	}

	.contact-link:hover {
		color: var(--color-primary);
	}

	.contact-action {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.contact-action .btn-primary {
		width: 100%;
		max-width: 320px;
	}
</style>
